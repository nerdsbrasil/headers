# Copie para .env.local (local) ou defina no servidor / docker compose.

# Chave que o bot envia em x-api-key para usar /api/render.
# Gere uma nova com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RENDER_API_KEY=

# Porta publicada na VPS (o container continua servindo na 3000 por dentro).
# PORT=2828

# De onde o Chrome carrega a página que vira PNG. Em Docker, o próprio container.
# RENDER_ORIGIN=http://127.0.0.1:3000

# Vazio usa o Chromium do Playwright (imagem Docker); "chrome" usa o Chrome local.
# CHROME_CHANNEL=
